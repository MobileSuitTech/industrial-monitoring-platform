<Window x:Class="industrial_monitoring_platform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:industrial_monitoring_platform"
        mc:Ignorable="d"
        Title="MainWindow" Height="715" Width="1060">
    
    <Grid>
        <StackPanel Margin="20">

            <TextBlock Text="Industrial Monitoring Platform"
               FontSize="24"
               FontWeight="Bold"
               Margin="0,0,0,10"/>

            <Separator Margin="0,5"/>

            <TextBlock x:Name="TimestampText"
               Text="Time"
               FontSize="16"
               Margin="0,5"/>

            <TextBlock x:Name="TemperatureText"
               Text="Temperature: -- °C"
               FontSize="16"
               Margin="0,5"/>

            <TextBlock x:Name="PressureText"
               Text="Pressure: -- bar"
               FontSize="16"
               Margin="0,5"/>

            <TextBlock x:Name="FlowRateText"
               Text="Flow Rate: -- L/min"
               FontSize="16"
               Margin="0,5"/>

            <TextBlock x:Name="TankLevelText"
               Text="Tank Level: -- %"
               FontSize="16"
               Margin="0,5"/>

            <Separator Margin="0,5"/>
            
            <TextBlock Text="Temperature Trend"
               FontSize="18"
               FontWeight="Bold"
               Margin="0,20,0,5"/>
            <lvc:CartesianChart x:Name="TemperatureChart"
               Height="150"/>


            <Separator Margin="0,5"/>
            
            <TextBlock x:Name="StatusText"
               FontSize="24"
               FontWeight="Bold"
               Text="System Status: OK"
               Margin="0,15,0,15"
            />

            <DataGrid x:Name="ReadingsGrid"
                  Height="150"
                  AutoGenerateColumns="False"
                  Margin="0, 10, 0, 0">
                      
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="*"/>
                    <DataGridTextColumn Header="Temp (°C)" Binding="{Binding TemperatureC}" Width="*"/>
                    <DataGridTextColumn Header="Pressure (bar)" Binding="{Binding PressureBar}" Width="*"/>
                    <DataGridTextColumn Header="Flow (L/min)" Binding="{Binding FlowRateLMin}" Width="*"/>
                    <DataGridTextColumn Header="Level (%)" Binding="{Binding TankLevelPercent}" Width="*"/>
                </DataGrid.Columns>
                
            </DataGrid>

        </StackPanel>



    </Grid>
    
</Window>
