<Window x:Class="industrial_monitoring_platform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:industrial_monitoring_platform"
        mc:Ignorable="d"
        Title="Mobile Suit Tech" Height="700" Width="1500">
    
    <Grid
        Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
               Grid.ColumnSpan="2"
               Text="Industrial Monitoring Platform"
               FontSize="24"
               FontWeight="Bold"
               Margin="0,0,0,10"/>


        <StackPanel Margin="0,0,15,0"
                    Grid.Row="1"
                    Grid.Column="0">
            <Separator Margin="0,13"/>
            <TextBlock x:Name="TimestampText"
               Text="Time"
               FontSize="16"
               Margin="0,5"/>

            <TextBlock x:Name="TemperatureText"
               Text="Temperature: -- °C"
               FontSize="16"
               Margin="0,5"/>

            <TextBlock x:Name="PressureText"
               Text="Pressure: -- bar"
               FontSize="16"
               Margin="0,5"/>

            <TextBlock x:Name="FlowRateText"
               Text="Flow Rate: -- L/min"
               FontSize="16"
               Margin="0,5"/>

            <TextBlock x:Name="TankLevelText"
               Text="Tank Level: -- %"
               FontSize="16"
               Margin="0,5"/>

            <Separator Margin="0,10"/>

            <TextBlock x:Name="StatusText"
               FontSize="24"
               FontWeight="Bold"
               Text="System Status: OK"
               Margin="0,0,0,0"
            />
            <Separator Margin="0,13"/>
            
            <TextBlock Text="Historian Stats" FontWeight="Bold" Margin="0,5,0,5"/>
            <TextBlock x:Name="DatabaseRowsText" Text="Database Rows: -" />
            <TextBlock x:Name="AverageTempText" Text="Average Temp: -" />
            <TextBlock x:Name="MinimumTempText" Text="Minimum Temp: -" />
            <TextBlock x:Name="MaximumTempText" Text="Maximum Temp: -" />
            
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1">
            
            <TextBlock Text="Temperature Trend"
               FontSize="18"
               FontWeight="Bold"
               Margin="0,20,0,5"/>
            
            <lvc:CartesianChart x:Name="TemperatureChart"
               Height="150"/>
        </StackPanel>

        <DataGrid x:Name="ReadingsGrid"
                      Grid.Row="2"
                     Grid.Column="0"

                  AutoGenerateColumns="False"
                  Margin="0, 10, 0, 0"
                  IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="*"/>
                <DataGridTextColumn Header="Temp (°C)" Binding="{Binding TemperatureC}" Width="*"/>
                <DataGridTextColumn Header="Pressure (bar)" Binding="{Binding PressureBar}" Width="*"/>
                <DataGridTextColumn Header="Flow (L/min)" Binding="{Binding FlowRateLMin}" Width="*"/>
                <DataGridTextColumn Header="Level (%)" Binding="{Binding TankLevelPercent}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>

    </Grid>
    
</Window>
